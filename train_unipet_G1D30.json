{
  "task": "aripet_full",
  "model": "unipet",
  "gpu_ids": [
    0
  ],
  "dist": false,
  "n_channels": 1,
  "manual_seed": 42,
  "path": {
    "root": "runs",
    "pretrained_netG": null,
    "pretrained_netE": null
  },
  "datasets": {
    "train": {
      "manifest": "splits/patients.csv",
      "dataloader_batch_size": 2,
      "dataloader_num_workers": 0
    },
    "val": {
      "manifest": "splits/patients.csv"
    }
  },
  "netG": {
    "net_type": "aripet",
    "init_type": "default",
    "init_bn_type": "uniform",
    "init_gain": 0.2,
    "spatial_prompt": true,
    "fourier_prompt": true
  },
  "train": {
    "G_lossfn_type": "charbonnier",
    "G_lossfn_weight": 1,
    "G_charbonnier_eps": 1e-9,
    "alpha": 15,
    "lambda_cls": 0.1,
    "lambda_orth": 0.01,
    "E_decay": 0.999,
    "G_optimizer_type": "adam",
    "G_optimizer_lr": 0.0002,
    "G_optimizer_wd": 0,
    "G_optimizer_clipgrad": null,
    "G_scheduler_milestones": [
      500000,
      1000000
    ],
    "G_scheduler_gamma": 0.5,
    "total_iterations": 2000000,
    "checkpoint_val": 50000,
    "checkpoint_save": 50000,
    "checkpoint_print": 200,
    "freeze_patch_embedding": false
  }
}
